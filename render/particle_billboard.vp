#version 140

in highp vec4 position;
in highp mat4 mtx_world;
in mediump vec2 texcoord0;
in mediump vec4 color;
in lowp float billboard_mode;

uniform particle_vp
{
    highp mat4 view_proj;
    highp mat4 view;
};

out mediump vec2 var_texcoord0;
out mediump vec4 var_color;

void main()
{
    highp vec3 right = vec3(view[0][0], view[1][0], view[2][0]);
    highp vec3 up = vec3(view[0][1], view[1][1], view[2][1]);
    highp vec3 center = mtx_world[3].xyz;
    highp vec3 axis_x = right;
    highp vec3 axis_y = up;
    if (billboard_mode > 0.5) {
        highp vec4 clip = view_proj * vec4(center, 1.0);
        highp vec2 radial = clip.xy / max(abs(clip.w), 0.001);
        highp float length_sq = dot(radial, radial);
        if (length_sq > 1e-6) {
            radial *= inversesqrt(length_sq);
            axis_x = right * radial.y - up * radial.x;
            axis_y = right * radial.x + up * radial.y;
        }
    }
    gl_Position = view_proj * vec4(center
        + axis_x * position.x * length(mtx_world[0].xyz)
        + axis_y * position.y * length(mtx_world[1].xyz), 1.0);
    var_texcoord0 = texcoord0;
    // The built-in particle fragment shader expects premultiplied vertex colour.
    var_color = vec4(color.rgb * color.a, color.a);
}
