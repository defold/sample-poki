name: "projectile_unlit"
tags: "model"
vertex_program: "/render/unlit.vp"
fragment_program: "/render/unlit.fp"
vertex_space: VERTEX_SPACE_LOCAL
vertex_constants { name: "mtx_worldview" type: CONSTANT_TYPE_WORLDVIEW }
vertex_constants { name: "mtx_proj" type: CONSTANT_TYPE_PROJECTION }
fragment_constants { name: "tint" type: CONSTANT_TYPE_USER value { x: 0.145 y: 0.95 z: 1.0 w: 1.0 } }
