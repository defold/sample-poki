#version 140

in highp vec4 position;
in mediump vec3 normal;
in highp mat4 mtx_world;
in highp mat4 mtx_normal;
in lowp vec4 planet_tint;
in mediump vec4 planet_bands;

uniform model_vp
{
    highp mat4 mtx_view;
    highp mat4 mtx_proj;
};

out highp vec3 var_normal;
#ifdef EDITOR
out highp vec3 var_view_center;
#else
flat out highp vec3 var_view_center;
#endif
out mediump vec3 var_local;
#ifdef EDITOR
out lowp vec4 var_tint;
out mediump vec4 var_bands;
#else
flat out lowp vec4 var_tint;
flat out mediump vec4 var_bands;
#endif

void main()
{
    highp vec4 view_position = mtx_view * (mtx_world * vec4(position.xyz, 1.0));
    // Defold's normal matrix already includes view. Normalize in highp before
    // interpolation: planet scaling can make its length unsafe for mediump.
    var_normal = normalize(mat3(mtx_normal) * normal);
    var_view_center = (mtx_view * mtx_world[3]).xyz;
    var_local = position.xyz;
    var_tint = planet_tint;
    var_bands = planet_bands;
    gl_Position = mtx_proj * view_position;
}
