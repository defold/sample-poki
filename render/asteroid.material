name: "asteroid"
tags: "model"
vertex_program: "/render/asteroid.vp"
fragment_program: "/render/toon.fp"
vertex_space: VERTEX_SPACE_LOCAL
vertex_constants { name: "mtx_worldview" type: CONSTANT_TYPE_WORLDVIEW }
vertex_constants { name: "mtx_proj" type: CONSTANT_TYPE_PROJECTION }
vertex_constants { name: "mtx_normal" type: CONSTANT_TYPE_NORMAL }
fragment_constants { name: "tint" type: CONSTANT_TYPE_USER value { x: 1.0 y: 1.0 z: 1.0 w: 1.0 } }
fragment_constants { name: "skin_tint" type: CONSTANT_TYPE_USER value { x: 1.0 y: 1.0 z: 1.0 w: 0.0 } }
fragment_constants { name: "damage_flash" type: CONSTANT_TYPE_USER value { x: 1.0 y: 0.05 z: 0.02 w: 0.0 } }
