name: "particle_billboard"
tags: "particle"
vertex_program: "/render/particle_billboard.vp"
fragment_program: "/builtins/materials/particlefx.fp"
vertex_space: VERTEX_SPACE_WORLD
vertex_constants {
  name: "view_proj"
  type: CONSTANT_TYPE_VIEWPROJ
}
vertex_constants {
  name: "view"
  type: CONSTANT_TYPE_VIEW
}
fragment_constants {
  name: "tint"
  type: CONSTANT_TYPE_USER
  value {
    x: 1.0
    y: 1.0
    z: 1.0
    w: 1.0
  }
}
samplers {
  name: "texture_sampler"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
}
max_page_count: 0
attributes {
  name: "position"
  semantic_type: SEMANTIC_TYPE_POSITION
  coordinate_space: COORDINATE_SPACE_LOCAL
  vector_type: VECTOR_TYPE_VEC4
}
attributes {
  name: "mtx_world"
  semantic_type: SEMANTIC_TYPE_WORLD_MATRIX
  coordinate_space: COORDINATE_SPACE_WORLD
  vector_type: VECTOR_TYPE_MAT4
}
attributes {
  name: "texcoord0"
  semantic_type: SEMANTIC_TYPE_TEXCOORD
  coordinate_space: COORDINATE_SPACE_LOCAL
  vector_type: VECTOR_TYPE_VEC2
  double_values {
    v: 0.0
    v: 0.0
  }
}
attributes {
  name: "color"
  semantic_type: SEMANTIC_TYPE_COLOR
  coordinate_space: COORDINATE_SPACE_LOCAL
  vector_type: VECTOR_TYPE_VEC4
  double_values {
    v: 1.0
    v: 1.0
    v: 1.0
    v: 1.0
  }
}
attributes {
  name: "billboard_mode"
  semantic_type: SEMANTIC_TYPE_NONE
  coordinate_space: COORDINATE_SPACE_LOCAL
  vector_type: VECTOR_TYPE_SCALAR
  double_values {
    v: 0.0
  }
}
